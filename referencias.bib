% ============================================================
%  REFERÊNCIAS BIBLIOGRÁFICAS – referencias.bib
%  Template PPGCA/UnB Planaltina
%  Use o formato BibTeX. Estilo: ABNT (abntex2cite)
%
@comment{
  Dicas:
  - Gere entradas via Google Scholar: botão Citar, depois BibTeX
  - Use o Zotero com Better BibTeX para exportacao automatica
  - Campos obrigatorios por tipo:
      article  : author, title, journal, year, volume, pages
      book     : author/editor, title, publisher, year
      inbook   : author, title, booktitle, publisher, year, pages
      thesis   : author, title, school, year, type
}
% ============================================================

% ---- Artigo em periódico ----
@article{exemplo:artigo:2024,
  author  = {Silva, João and Souza, Maria and Oliveira, Pedro},
  title   = {Título do artigo científico de exemplo},
  journal = {Nome da Revista Científica},
  year    = {2024},
  volume  = {10},
  number  = {2},
  pages   = {100--120},
  doi     = {10.1000/xyz123},
  url     = {https://doi.org/10.1000/xyz123},
}

% ---- Livro ----
@book{exemplo:livro:2020,
  author    = {Autor, Nome do},
  title     = {Título do Livro},
  edition   = {3},
  publisher = {Editora},
  address   = {São Paulo},
  year      = {2020},
  isbn      = {978-000-000-000-0},
}

% ---- Capítulo de livro ----
@inbook{exemplo:capitulo:2019,
  author    = {Capítulo, Autor do},
  title     = {Título do Capítulo},
  booktitle = {Título do Livro Completo},
  editor    = {Editor, Nome do},
  publisher = {Editora},
  address   = {Rio de Janeiro},
  year      = {2019},
  pages     = {45--78},
}

% ---- Tese de doutorado ----
@phdthesis{exemplo:tese:2023,
  author  = {Doutorando, Nome do},
  title   = {Título da Tese de Doutorado},
  school  = {Universidade de Brasília},
  address = {Brasília},
  year    = {2023},
  type    = {Tese (Doutorado em Ciências Ambientais)},
  url     = {https://repositorio.unb.br},
}

% ---- Dissertação de mestrado ----
@mastersthesis{exemplo:dissertacao:2022,
  author  = {Mestrando, Nome do},
  title   = {Título da Dissertação de Mestrado},
  school  = {Universidade de Brasília},
  address = {Brasília},
  year    = {2022},
  type    = {Dissertação (Mestrado em Ciências Ambientais)},
}

% ---- Relatório técnico / documento institucional ----
@techreport{exemplo:relatorio:2021,
  author      = {{Instituição ou Órgão}},
  title       = {Título do Relatório Técnico},
  institution = {Nome da Instituição},
  address     = {Brasília},
  year        = {2021},
  type        = {Relatório Técnico},
  number      = {RT-001/2021},
}

% ---- Recurso eletrônico / site ----
@misc{exemplo:web:2024,
  author       = {Autor, Nome do},
  title        = {Título da Página ou Documento Online},
  howpublished = {Disponível em: \url{https://www.exemplo.com}},
  year         = {2024},
  note         = {Acesso em: 01 jan. 2024},
}

% ---- Artigo em anais de congresso ----
@inproceedings{exemplo:anais:2023,
  author    = {Apresentador, Nome do and Coautor, Nome do},
  title     = {Título do Trabalho Apresentado},
  booktitle = {Anais do Congresso Brasileiro de Ciências Ambientais},
  year      = {2023},
  pages     = {200--215},
  publisher = {Editora dos Anais},
  address   = {Brasília},
}

% ---- Legislação / norma ----
@misc{brasil:lei:2012,
  author       = {{Brasil}},
  title        = {Lei n. 12.651, de 25 de maio de 2012 -- Código Florestal},
  howpublished = {Diário Oficial da União},
  year         = {2012},
  note         = {Disponível em: \url{https://www.planalto.gov.br}. Acesso em: 01 jan. 2024},
}

